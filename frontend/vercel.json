{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "yarn install",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
